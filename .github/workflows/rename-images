name: Renombrar Imágenes Automáticamente

on:
  push:
    branches:
      - MochilaDeCaleb
    paths:
      - '**/images/**' # Detecta cualquier carpeta llamada 'images' en la rama
      # Si tus imágenes están en la raíz o en otra ruta específica (ej. 'MochilaDeCaleb/images/**'), cámbiala aquí.

jobs:
  rename:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout del repositorio
        uses: actions/checkout@v4
        with:
          ref: MochilaDeCaleb # Asegura que trabaje específicamente sobre tu rama

      - name: Renombrar y organizar imágenes
        run: |
          # ⚠️ CAMBIA ESTA RUTA si la carpeta de tus imágenes tiene otro nombre o ubicación exacta 
          # (Ejemplo: "ruta/a/tu/carpeta/images" o simplemente "." si están sueltas en la raíz)
          TARGET_DIR="."
          
          if [ -d "$TARGET_DIR" ]; then
            cd "$TARGET_DIR"
            
            # Contador inicial
            i=1
            
            # Renombramos a un nombre temporal para evitar conflictos de sobreescritura
            find . -maxdepth 1 -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" -o -iname "*.gif" \) | sort | while read -r file; do
              ext="${file##*.}"
              ext=$(echo "$ext" | tr '[:upper:]' '[:lower:]')
              new_name="../temp_img_$i.$ext"
              mv "$file" "$new_name"
              i=$((i + 1))
            done
            
            # Segunda pasada para asignar los nombres finales Image1, Image2... ordenados
            j=1
            find . -maxdepth 1 -type f -name "temp_img_*" | sort -V | while read -r temp_file; do
              ext="${temp_file##*.}"
              mv "$temp_file" "./Image$j.$ext"
              j=$((j + 1))
            done
            
            cd ..
          else
            echo "La carpeta '$TARGET_DIR' no existe. Revisa la ruta."
          fi

      - name: Commit y Push de los cambios
        uses: stefanzweifel/git-auto-commit-action@v5
        with:
          commit_message: "Automático: Renombrar imágenes a Image1, Image2..."
          branch: MochilaDeCaleb
          create_branch: false
